<style>
:root{
  --bg:#f6f9fc;--surface:#ffffff;--ink:#14213d;--muted:#4a5878;--line:#d5deea;
  --dawn:#14213d;--dawn2:#23366b;--dawn-ink:#f6f9fc;--sun:#fb8500;--sun-ink:#14213d;--sky:#8ecae6;--wa:#25d366;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0d1526;--surface:#16213a;--ink:#eef3fa;--muted:#aab6cc;--line:#2a3857;--dawn:#070d1b;--dawn2:#16254a;}}
:root[data-theme="dark"]{--bg:#0d1526;--surface:#16213a;--ink:#eef3fa;--muted:#aab6cc;--line:#2a3857;--dawn:#070d1b;--dawn2:#16254a;}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.7 "Hind",system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:"Baloo 2","Hind",system-ui,sans-serif;line-height:1.2;margin:0 0 .5em}
h2{font-size:clamp(1.7rem,4vw,2.3rem);font-weight:800}
h3{font-size:1.25rem;font-weight:700}
p{margin:0 0 1em;max-width:62ch}
a{color:inherit}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
section{padding:64px 0}
.btn{display:inline-block;background:var(--sun);color:var(--sun-ink);font-weight:600;padding:13px 26px;border-radius:999px;text-decoration:none;border:0;font-size:1rem;cursor:pointer;font-family:inherit;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(251,133,0,.35)}
.btn.ghost{background:transparent;color:inherit;border:2px solid currentColor}
.btn.wa{background:var(--wa);color:#073b1c}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--dawn);color:var(--dawn-ink)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:10px;padding-bottom:10px}
nav b{font-family:"Baloo 2",sans-serif;font-size:1.1rem}
nav a.btn{padding:8px 18px;font-size:.95rem}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--dawn);z-index:30}

.hero{background:linear-gradient(180deg,var(--dawn) 0%,var(--dawn2) 100%);color:var(--dawn-ink);padding:64px 0 72px;position:relative;overflow:hidden}
.hero .wrap{display:grid;gap:36px;grid-template-columns:1.15fr .85fr;align-items:center}
.hero h1{font-size:clamp(2.1rem,5.6vw,3.6rem);font-weight:800}
.hero p{font-size:1.15rem;color:#dbe6f6}
.hero .cta{display:flex;flex-wrap:wrap;gap:12px}
.chat{display:grid;gap:14px;justify-items:start}
.bub{max-width:88%;padding:12px 18px;border-radius:20px 20px 20px 4px;background:var(--surface);color:var(--ink);font-weight:600;box-shadow:0 10px 24px rgba(0,0,0,.25);opacity:0;transform:translateY(16px) scale(.96)}
.bub small{display:block;font-weight:400;color:var(--muted);font-size:.85rem}
.bub.me{justify-self:end;background:var(--sun);color:var(--sun-ink);border-radius:20px 20px 4px 20px}
.bub.me small{color:#5a3300}
.pill{display:inline-block;border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:4px 16px;font-size:.95rem;margin-bottom:16px;color:var(--sky)}
@media(max-width:780px){.hero .wrap{grid-template-columns:1fr}}

.grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:24px;transition:transform .25s,box-shadow .25s,border-color .25s}
.card:hover{transform:translateY(-6px);box-shadow:0 14px 30px rgba(20,33,61,.15);border-color:var(--sun)}
.card .tag{display:inline-block;background:var(--sky);color:#14213d;font-weight:600;font-size:.85rem;padding:2px 12px;border-radius:999px;margin-bottom:10px}
.card ul{margin:0;padding-left:1.1em;color:var(--muted)}
.band{background:var(--surface);border-block:1px solid var(--line)}
.band .card{background:var(--bg)}
.six{display:flex;flex-wrap:wrap;gap:10px;padding:0;margin:20px 0 0;list-style:none}
.six li{border:2px solid var(--sun);border-radius:999px;padding:6px 18px;font-weight:600;transition:background .2s,color .2s}
.six li:hover{background:var(--sun);color:var(--sun-ink)}
.steps{counter-reset:s;list-style:none;margin:0;padding:0;display:grid;gap:16px}
.steps li{counter-increment:s;display:grid;grid-template-columns:48px 1fr;gap:14px;align-items:start}
.steps li::before{content:counter(s);display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--sun);color:var(--sun-ink);font-family:"Baloo 2",sans-serif;font-weight:800;font-size:1.2rem}
.steps b{display:block}
.steps span{color:var(--muted)}
.visit{display:grid;gap:24px;grid-template-columns:1fr 1fr;align-items:center}
@media(max-width:780px){.visit{grid-template-columns:1fr}}
.visit .box{background:var(--dawn);color:var(--dawn-ink);border-radius:16px;padding:28px}
.visit .box p{color:#dbe6f6}
.visit .box .btn{margin:4px 8px 4px 0}
form{display:grid;gap:14px;max-width:560px}
label{display:grid;gap:6px;font-weight:600}
input,select,textarea{font:inherit;padding:12px 14px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);width:100%}
.note{font-size:.92rem;color:var(--muted)}
#msg{font-weight:600;color:var(--sun)}
details{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:14px 18px;margin-bottom:10px}
summary{cursor:pointer;font-weight:600}
details p{margin:10px 0 0;color:var(--muted)}
.links{display:flex;flex-wrap:wrap;gap:12px}
.links a{border:1px solid var(--line);background:var(--surface);padding:10px 18px;border-radius:999px;text-decoration:none;font-weight:600;transition:transform .2s,border-color .2s}
.links a:hover{transform:translateY(-3px);border-color:var(--sun)}
footer{background:var(--dawn);color:var(--dawn-ink);padding:36px 0;text-align:center;font-size:.95rem}
footer p{margin:0 auto .4em}
.fab{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:25;background:var(--wa);color:#073b1c;font-weight:700;text-decoration:none;padding:12px 20px;border-radius:999px;box-shadow:0 8px 22px rgba(0,0,0,.3)}

@media(prefers-reduced-motion:no-preference){
  .bub{animation:pop .6s cubic-bezier(.2,.9,.3,1.2) forwards}
  .bub:nth-child(1){animation-delay:.3s}.bub:nth-child(2){animation-delay:1.3s}.bub:nth-child(3){animation-delay:2.3s}.bub:nth-child(4){animation-delay:3.3s}
  .hero h1,.hero p,.hero .cta,.pill{animation:slide .8s ease-out both}
  .hero p{animation-delay:.15s}.hero .cta{animation-delay:.3s}
  .rv{opacity:0;transform:translateY(28px);transition:opacity .7s ease,transform .7s ease}
  .rv.in{opacity:1;transform:none}
  .fab{animation:pulse 2.4s ease-in-out infinite}
}
@media(prefers-reduced-motion:reduce){.bub{opacity:1;transform:none}}
@keyframes pop{to{opacity:1;transform:none}}
@keyframes slide{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
